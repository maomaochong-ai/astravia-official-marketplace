{
  "title": "外呼中心运营看板",
  "type": "dashboard",
  "layout": "grid-3",
  "connection_name": "pgsql-dev",
  "table": "new_schema.new_table",
  "charts": [
    {
      "type": "metric",
      "title": "核心指标",
      "description": "取数窗口 2026-10-08 09:00–14:25 · 全部 10 条外呼记录",
