{
  "id": "xiaohongshu",
  "name": "%name%",
  "icon": "assets/icon.png",
  "version": "1.1.28",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "styles": [
    "dist/style.css"
  ],
  "moduleFederation": {
    "remoteName": "xiaohongshu",
    "expose": "./plugin"
  },
  "permissions": [
    "agent.mcp.control",
    "ui.slot.ability-detail",
    "ui.slot.workspace-view",
    "storage.read",
    "storage.write",
    "secrets.read",
    "secrets.write",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "github.com",
      "release-assets.githubusercontent.com"
    ]
  },
  "providers": {
    "services": [
      {
        "id": "xhs",
        "runtime": {
          "kind": "host-node",
          "version": "1.1.27",
          "entry": "service/dist/main.js",
          "platforms": {
            "win32-x64": {
              "executable": "service/dist/main.js",
              "artifacts": [
                {
                  "sha256": "434c1240b626cb231a4b9c19ef53e37b8e95b6347a251befd23a4ae79b4006b5",
                  "archive": "zip",
                  "destination": "service"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "service/dist/main.js",
              "artifacts": [
                {
                  "sha256": "434c1240b626cb231a4b9c19ef53e37b8e95b6347a251befd23a4ae79b4006b5",
                  "archive": "zip",
                  "destination": "service"
                }
              ]
            },
            "linux-x64": {
              "executable": "service/dist/main.js",
              "artifacts": [
                {
                  "sha256": "434c1240b626cb231a4b9c19ef53e37b8e95b6347a251befd23a4ae79b4006b5",
                  "archive": "zip",
                  "destination": "service"
                }
              ]
            }
          }
        },
        "process": {
          "args": [],
          "env": {
            "ASTRAVIA_SERVICE_PORT": "${ASTRAVIA_SERVICE_PORT}",
            "ASTRAVIA_SERVICE_DATA_DIR": "${ASTRAVIA_SERVICE_DATA_DIR}",
            "XHS_HEADLESS": "false"
          }
        },
        "health": {
          "path": "/health",
          "timeoutMs": 120000
        }
      }
    ]
  },
  "agent": {
    "mcpServers": {
      "xiaohongshu": {
        "type": "service",
        "serviceId": "xhs",
        "path": "/mcp",
        "displayName": "Xiaohongshu tools",
        "description": "Use a selected Xiaohongshu account for search, note and interaction operations; omit account_id to use the active account."
      }
    }
  },
  "description": "%description%",
  "author": "Astravia",
  "defaultLocale": "zh"
}
