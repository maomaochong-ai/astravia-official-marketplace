{
  "id": "open-ai-canvas",
  "name": "Open AI Canvas",
  "icon": "assets/icon.png",
  "version": "0.1.9",
  "defaultLocale": "zh",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "openAiCanvas",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "ui.slot.workspace-view",
    "agent.mcp.control",
    "storage.read",
    "storage.write",
    "shell.openExternal",
    "ai.models.list",
    "ai.complete",
    "media.provider.register"
  ],
  "providers": {
    "services": [
      {
        "id": "open-ai-canvas",
        "runtime": {
          "kind": "host-node",
          "version": "0.2.3",
          "entry": "server/boot.mjs",
          "platforms": {
            "win32-x64": {
              "executable": "server/boot.mjs",
              "artifacts": [
                {
                  "sha256": "cd0d1655260661bb0a5f05a97ab91e3dba9a9fabdbbe1ef120a4162d16122edb",
                  "archive": "file",
                  "destination": "server/boot.mjs"
                }
              ]
            },
            "darwin-x64": {
              "executable": "server/boot.mjs",
              "artifacts": [
                {
                  "sha256": "cd0d1655260661bb0a5f05a97ab91e3dba9a9fabdbbe1ef120a4162d16122edb",
                  "archive": "file",
                  "destination": "server/boot.mjs"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "server/boot.mjs",
              "artifacts": [
                {
                  "sha256": "cd0d1655260661bb0a5f05a97ab91e3dba9a9fabdbbe1ef120a4162d16122edb",
                  "archive": "file",
                  "destination": "server/boot.mjs"
                }
              ]
            },
            "linux-x64": {
              "executable": "server/boot.mjs",
              "artifacts": [
                {
                  "sha256": "cd0d1655260661bb0a5f05a97ab91e3dba9a9fabdbbe1ef120a4162d16122edb",
                  "archive": "file",
                  "destination": "server/boot.mjs"
                }
              ]
            },
            "linux-arm64": {
              "executable": "server/boot.mjs",
              "artifacts": [
                {
                  "sha256": "cd0d1655260661bb0a5f05a97ab91e3dba9a9fabdbbe1ef120a4162d16122edb",
                  "archive": "file",
                  "destination": "server/boot.mjs"
                }
              ]
            }
          }
        },
        "process": {
          "args": [],
          "env": {
            "ASTRAVIA_SERVICE_PORT": "${ASTRAVIA_SERVICE_PORT}",
            "ASTRAVIA_SERVICE_DATA_DIR": "${ASTRAVIA_SERVICE_DATA_DIR}",
            "ASTRAVIA_SERVICE_RUNTIME_DIR": "${ASTRAVIA_SERVICE_RUNTIME_DIR}",
            "ASTRAVIA_SERVICE_CACHE_DIR": "${ASTRAVIA_SERVICE_CACHE_DIR}",
            "ASTRAVIA_SERVICE_SECRET_SESSION_KEY": "${ASTRAVIA_SERVICE_SECRET_SESSION_KEY}"
          }
        },
        "credentials": [
          {
            "id": "session-key",
            "bytes": 32
          }
        ],
        "health": {
          "path": "/api/health/ready",
          "timeoutMs": 120000
        }
      }
    ]
  },
  "agent": {
    "mcpServers": {
      "open-ai-canvas": {
        "type": "service",
        "serviceId": "open-ai-canvas",
        "path": "/mcp",
        "displayName": "Open AI Canvas tools",
        "description": "Manage canvas projects, canvases, nodes and generation tasks through the host agent."
      }
    }
  },
  "description": "Open-source AI canvas for text-to-image, image-to-video and more, integrated into Astravia as a plugin.",
  "author": "Astravia Community"
}
