{
  "id": "open-ai-canvas",
  "name": "Open AI Canvas",
  "icon": "assets/icon.png",
  "version": "0.0.3",
  "defaultLocale": "zh",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "openAiCanvas",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "ui.slot.workspace-view",
    "agent.mcp.control",
    "storage.read",
    "storage.write",
    "shell.openExternal"
  ],
  "providers": {
    "services": [
      {
        "id": "open-ai-canvas",
        "runtime": {
          "kind": "host-node",
          "version": "2.1.0",
          "entry": "server/boot.mjs",
          "platforms": {
            "darwin-arm64": {
              "executable": "server/boot.mjs",
              "artifacts": [
                {
                  "sha256": "99b224327e3ae8cde8c16ca2bc929847ae9437e6ea36a986ac6b876e957f28bc",
                  "archive": "zip",
                  "destination": "server"
                }
              ]
            }
          }
        },
        "process": {
          "args": []
        },
        "health": {
          "path": "/api/health/ready",
          "timeoutMs": 120000
        }
      }
    ]
  },
  "agent": {
    "mcpServers": {
      "open-ai-canvas": {
        "type": "service",
        "serviceId": "open-ai-canvas",
        "path": "/mcp",
        "displayName": "Open AI Canvas tools",
        "description": "Manage canvas projects, canvases, nodes and generation tasks through the host agent."
      }
    }
  },
  "description": "Open-source AI canvas for text-to-image, image-to-video and more, integrated into Astravia as a plugin.",
  "author": "Astravia Community"
}
