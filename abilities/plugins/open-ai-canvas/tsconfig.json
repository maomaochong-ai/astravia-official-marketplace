{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"strict": true,
		"esModuleInterop": true,
		"skipLibCheck": true,
		"forceConsistentCasingInFileNames": true,
		"moduleResolution": "bundler",
		"isolatedModules": true,
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"noEmit": true,
		// 源码用显式 .ts/.tsx 后缀（esbuild 打包与 Node 直跑都靠它）；tsc 需要这个开关才不报 TS5097。
		"allowImportingTsExtensions": true,
		"types": [
			"node"
		]
	},
	"include": [
		"src/**/*.ts",
		"src/**/*.tsx",
		"src/**/*.d.ts",
		"test/**/*.ts",
		"test/**/*.tsx"
	]
}
