{
  "name": "@astravia/plugin-open-ai-canvas",
  "version": "0.1.2",
  "private": true,
  "type": "module",
  "scripts": {
    "shim": "node scripts/sync-shim.mjs",
    "check:platforms": "node scripts/check-service-platforms.mjs",
    "check:build-workflow": "node scripts/check-build-workflow.mjs",
    "manifest": "node scripts/build-payload-manifest.mjs",
    "verify:bridge": "node scripts/verify-bridge.mjs",
    "verify:web": "node scripts/verify-web-hosting.mjs",
    "verify:payload-sources": "node scripts/verify-payload-sources.mjs",
    "verify:workflow": "node scripts/verify-workflow.mjs",
    "verify": "npm run check && npm run check:build-workflow && npm run verify:workflow && npm run verify:bridge && npm run verify:web && npm run verify:payload-sources",
    "test": "node scripts/check-build-workflow.mjs && node scripts/verify-workflow.mjs && node scripts/verify-bridge.mjs && node scripts/verify-web-hosting.mjs && node scripts/verify-payload-sources.mjs",
    "build:service": "node scripts/build-service-zip.mjs",
    "build": "npm run shim && npm run check:platforms && npm run check:build-workflow && tsc --noEmit && vite build",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@iconify-json/solar": "^1.2.5",
    "@iconify/tailwind4": "^1.0.6",
    "@tailwindcss/vite": "^4.1.12",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "@astravia-org/plugin-sdk": "^0.3.10",
    "@astravia-org/plugin-vite": "^0.2.4",
    "@astravia-org/ui": "^0.1.0",
    "adm-zip": "0.5.18",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
