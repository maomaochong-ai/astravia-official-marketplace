{
  "id": "astravia-tihu",
  "name": "%name%",
  "version": "0.3.1",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "astravia_tihu",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "ui.slot.activity-tab",
    "agent.tools.register",
    "agent.toolHandler.execute"
  ],
  "guidingWords": [
    "%guidingWords.faster%",
    "%guidingWords.jumpAndRing%",
    "%guidingWords.rain%"
  ],
  "description": "%description%",
  "author": "Astravia",
  "icon": "solar:bicycling-bold",
  "defaultLocale": "en"
}
