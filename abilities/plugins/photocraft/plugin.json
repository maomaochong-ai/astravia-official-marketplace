{
  "id": "photocraft",
  "name": "%plugin.name%",
  "icon": "assets/icon.png",
  "version": "0.0.12",
  "defaultLocale": "en",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "photocraft",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "ui.slot.activity-tab",
    "fs.read",
    "fs.write",
    "workspace.read",
    "agent.tools.register",
    "agent.toolHandler.execute",
    "agent.skills.control"
  ],
  "providers": {
    "services": [
      {
        "id": "photocraft-hub",
        "runtime": {
          "kind": "host-node",
          "version": "0.0.12",
          "entry": "server/hub.mjs",
          "platforms": {
            "win32-x64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "a0ae17a303d05aa2f15d80bea8e1afaf72e45b8c04854c998ee07085705b23dc",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            },
            "darwin-x64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "a0ae17a303d05aa2f15d80bea8e1afaf72e45b8c04854c998ee07085705b23dc",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "a0ae17a303d05aa2f15d80bea8e1afaf72e45b8c04854c998ee07085705b23dc",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            },
            "linux-x64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "a0ae17a303d05aa2f15d80bea8e1afaf72e45b8c04854c998ee07085705b23dc",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            },
            "linux-arm64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "a0ae17a303d05aa2f15d80bea8e1afaf72e45b8c04854c998ee07085705b23dc",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            }
          }
        },
        "process": {
          "args": [],
          "env": {
            "ASTRAVIA_SERVICE_PORT": "${ASTRAVIA_SERVICE_PORT}",
            "ASTRAVIA_SERVICE_DATA_DIR": "${ASTRAVIA_SERVICE_DATA_DIR}",
            "ASTRAVIA_SERVICE_RUNTIME_DIR": "${ASTRAVIA_SERVICE_RUNTIME_DIR}",
            "ASTRAVIA_SERVICE_CACHE_DIR": "${ASTRAVIA_SERVICE_CACHE_DIR}"
          }
        },
        "health": {
          "path": "/health",
          "timeoutMs": 20000
        }
      }
    ]
  },
  "agent": {
    "skillPaths": [
      "agent/skills/photocraft"
    ],
    "skillPresentation": {
      "defaultVisibility": "visible",
      "surfaces": {
        "commandPalette": "visible",
        "skillPicker": "visible"
      }
    }
  },
  "description": "%plugin.description%",
  "author": "Astravia"
}
