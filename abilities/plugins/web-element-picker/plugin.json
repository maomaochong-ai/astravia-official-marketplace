{
  "id": "web-element-picker",
  "name": "%plugin.name%",
  "icon": "assets/icon.png",
  "version": "0.3.4",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "web_element_picker",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "ui.slot.activity-tab",
    "ui.slot.input-action",
    "ui.slot.ability-detail",
    "agent.session.read",
    "agent.session.write",
    "storage.read",
    "storage.write",
    "shell.openExternal"
  ],
  "defaultLocale": "zh",
  "description": "%plugin.description%",
  "author": "Astravia"
}
