{
  "id": "rea",
  "name": "%name%",
  "version": "0.4.4",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "rea",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "minAppVersion": "0.5.60",
  "permissions": [
    "ui.slot.activity-tab",
    "ui.slot.input-action",
    "agent.skills.control",
    "agent.mcp.control",
    "agent.tools.register",
    "agent.toolHandler.execute",
    "agent.systemPrompt.write",
    "agent.continuation.register",
    "agent.session.read",
    "agent.session.write",
    "agent.command.run",
    "agent.command.spawn"
  ],
  "commands": [
    "node",
    "java",
    "frida",
    "adb",
    "apktool",
    "binwalk",
    "objdump",
    "gdb",
    "rizin",
    "cutter",
    "jadx",
    "unblob",
    "tshark",
    "capinfos",
    "sigrok-cli",
    "wasm-validate",
    "mitmdump",
    "brew",
    "pipx"
  ],
  "providers": {
    "cli": [
      {
        "id": "rea-agents",
        "command": "npx",
        "probe": {
          "args": [
            "-y",
            "rea-agents@latest",
            "--version"
          ],
          "timeoutMs": 60000
        },
        "install": {
          "command": "npx",
          "args": [
            "-y",
            "rea-agents@latest",
            "--version"
          ],
          "timeoutMs": 600000
        }
      }
    ]
  },
  "agent": {
    "skillPaths": [
      "agent/skills/reverse-engineer-anything"
    ],
    "mcpServers": {
      "rea": {
        "command": "npx",
        "args": [
          "-y",
          "rea-agents@latest",
          "mcp"
        ]
      }
    }
  },
  "description": "%description%",
  "author": "morluto / REA",
  "defaultLocale": "en"
}
