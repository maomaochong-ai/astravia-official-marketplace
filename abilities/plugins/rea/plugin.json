{
  "id": "rea",
  "name": "%name%",
  "version": "0.5.0",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "icon": "assets/icon.svg",
  "moduleFederation": {
    "remoteName": "rea",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "minAppVersion": "0.5.60",
  "permissions": [
    "ui.slot.activity-tab",
    "ui.slot.input-action",
    "agent.skills.control",
    "agent.mcp.control",
    "agent.tools.register",
    "agent.toolHandler.execute",
    "agent.systemPrompt.write",
    "agent.continuation.register",
    "agent.session.read",
    "agent.session.write",
    "agent.command.run",
    "agent.command.spawn",
    "storage.read",
    "storage.write",
    "fs.read",
    "agent.hooks.register",
    "agent.hookHandler.execute",
    "ui.file-explorer.context-menu"
  ],
  "commands": [
    "node",
    "java",
    "frida",
    "adb",
    "apktool",
    "binwalk",
    "objdump",
    "gdb",
    "rizin",
    "cutter",
    "jadx",
    "unblob",
    "tshark",
    "capinfos",
    "sigrok-cli",
    "wasm-validate",
    "mitmdump",
    "brew",
    "pipx"
  ],
  "providers": {
    "cli": [
      {
        "id": "rea-agents",
        "command": "npx",
        "probe": {
          "args": [
            "-y",
            "rea-agents@6.7.0",
            "--version"
          ],
          "timeoutMs": 60000
        },
        "install": {
          "command": "npx",
          "args": [
            "-y",
            "rea-agents@6.7.0",
            "--version"
          ],
          "timeoutMs": 600000
        }
      }
    ]
  },
  "agent": {
    "skillPaths": [
      "agent/skills/reverse-engineer-anything",
      "agent/skills/rea-investigation"
    ],
    "skillPresentation": {
      "defaultVisibility": "visible",
      "surfaces": {
        "skillPicker": "visible",
        "commandPalette": "visible",
        "abilityCatalog": "visible",
        "agentConfiguration": "visible",
        "pluginDetail": "visible"
      },
      "skills": {
        "reverse-engineer-anything": {
          "displayName": "%skill.name%",
          "displayDescription": "%skill.description%"
        },
        "rea-investigation": {
          "defaultVisibility": "hidden",
          "displayName": "%skill.investigation.name%",
          "displayDescription": "%skill.investigation.description%"
        }
      }
    },
    "mcpServers": {
      "rea": {
        "command": "npx",
        "args": [
          "-y",
          "rea-agents@6.7.0",
          "mcp"
        ]
      }
    },
    "agents": [
      {
        "id": "rea-investigator",
        "name": "%agent.investigator.name%",
        "description": "%agent.investigator.description%",
        "mentionHandle": "rea",
        "avatar": "agent/agents/rea-investigator.png",
        "systemPromptPath": "agent/agents/rea-investigator.md",
        "abilities": "own"
      }
    ]
  },
  "description": "%description%",
  "author": "morluto / REA",
  "defaultLocale": "en"
}
