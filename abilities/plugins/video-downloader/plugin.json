{
  "id": "video-downloader",
  "name": "%name%",
  "description": "%description%",
  "icon": "assets/icon.svg",
  "version": "1.3.0",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "styles": ["dist/style.css"],
  "moduleFederation": {
    "remoteName": "video-downloader",
    "expose": "./plugin"
  },
  "permissions": [
    "agent.mcp.control",
    "ui.slot.ability-detail",
    "ui.slot.workspace-view",
    "ui.slot.activity-tab",
    "ui.slot.input-action",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": ["github.com", "release-assets.githubusercontent.com", "registry.npmmirror.com"]
  },
