{
  "id": "video-downloader",
  "name": "%name%",
  "description": "%description%",
  "icon": "assets/icon.svg",
  "version": "2.0.0",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "styles": [
    "dist/style.css"
  ],
  "moduleFederation": {
    "remoteName": "video-downloader",
    "expose": "./plugin"
  },
  "permissions": [
    "agent.mcp.control",
    "ui.slot.ability-detail",
    "ui.slot.workspace-view",
    "ui.slot.activity-tab",
    "ui.slot.input-action",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "github.com",
      "release-assets.githubusercontent.com",
      "registry.npmmirror.com"
    ]
  },
  "providers": {
    "services": [
      {
        "id": "video-downloader",
        "runtime": {
          "kind": "host-node",
          "version": "2.0.0",
          "entry": "service/dist/main.js",
          "platforms": {
            "win32-x64": {
              "executable": "service/dist/main.js",
              "artifacts": [
                {
                  "sha256": "947a213731db8ddaf1cab8f1964c981b06926391798f4ee9b771fafba78b97ab",
                  "archive": "zip",
                  "destination": "service"
                }
              ]
            },
            "win32-arm64": {
              "executable": "service/dist/main.js",
              "artifacts": [
                {
                  "sha256": "947a213731db8ddaf1cab8f1964c981b06926391798f4ee9b771fafba78b97ab",
                  "archive": "zip",
                  "destination": "service"
                }
              ]
            },
            "darwin-x64": {
              "executable": "service/dist/main.js",
              "artifacts": [
                {
                  "sha256": "947a213731db8ddaf1cab8f1964c981b06926391798f4ee9b771fafba78b97ab",
                  "archive": "zip",
                  "destination": "service"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "service/dist/main.js",
              "artifacts": [
                {
                  "sha256": "947a213731db8ddaf1cab8f1964c981b06926391798f4ee9b771fafba78b97ab",
                  "archive": "zip",
                  "destination": "service"
                }
              ]
            },
            "linux-x64": {
              "executable": "service/dist/main.js",
              "artifacts": [
                {
                  "sha256": "947a213731db8ddaf1cab8f1964c981b06926391798f4ee9b771fafba78b97ab",
                  "archive": "zip",
                  "destination": "service"
                }
              ]
            },
            "linux-arm64": {
              "executable": "service/dist/main.js",
              "artifacts": [
                {
                  "sha256": "947a213731db8ddaf1cab8f1964c981b06926391798f4ee9b771fafba78b97ab",
                  "archive": "zip",
                  "destination": "service"
                }
              ]
            }
          }
        },
        "process": {
          "args": [],
          "env": {
            "ASTRAVIA_SERVICE_PORT": "${ASTRAVIA_SERVICE_PORT}",
            "ASTRAVIA_SERVICE_DATA_DIR": "${ASTRAVIA_SERVICE_DATA_DIR}",
            "ASTRAVIA_SERVICE_RUNTIME_DIR": "${ASTRAVIA_SERVICE_RUNTIME_DIR}",
            "ASTRAVIA_SERVICE_CACHE_DIR": "${ASTRAVIA_SERVICE_CACHE_DIR}"
          }
        },
        "health": {
          "path": "/health",
          "timeoutMs": 60000
        }
      }
    ]
  },
  "agent": {
    "mcpServers": {
      "video-downloader": {
        "type": "service",
        "serviceId": "video-downloader",
        "path": "/mcp",
        "displayName": "Video Downloader",
        "description": "Probe and download video or audio from a supported site URL; can list tasks and reveal finished files."
      }
    }
  },
  "author": "Astravia",
  "defaultLocale": "en"
}
