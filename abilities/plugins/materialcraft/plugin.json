{
  "id": "materialcraft",
  "name": "MaterialCraft",
  "icon": "assets/icon.png",
  "version": "0.0.2",
  "defaultLocale": "en",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "materialcraft",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "ui.slot.activity-tab",
    "browser.open",
    "shell.openExternal",
    "fs.read",
    "fs.write",
    "workspace.read",
    "agent.tools.register",
    "agent.toolHandler.execute",
    "agent.skills.control"
  ],
  "browser": {
    "allowedHosts": [
      "127.0.0.1"
    ]
  },
  "providers": {
    "services": [
      {
        "id": "materialcraft-hub",
        "runtime": {
          "kind": "host-node",
          "version": "0.0.2",
          "entry": "server/hub.mjs",
          "platforms": {
            "win32-x64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "071bc289e8c74504d7249b51f7d6867a0c4a1ead1cf0f02ad00154b3afc170e0",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            },
            "darwin-x64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "071bc289e8c74504d7249b51f7d6867a0c4a1ead1cf0f02ad00154b3afc170e0",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "071bc289e8c74504d7249b51f7d6867a0c4a1ead1cf0f02ad00154b3afc170e0",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            },
            "linux-x64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "071bc289e8c74504d7249b51f7d6867a0c4a1ead1cf0f02ad00154b3afc170e0",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            },
            "linux-arm64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "071bc289e8c74504d7249b51f7d6867a0c4a1ead1cf0f02ad00154b3afc170e0",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            }
          }
        },
        "process": {
          "args": [],
          "env": {
            "ASTRAVIA_SERVICE_PORT": "${ASTRAVIA_SERVICE_PORT}",
            "ASTRAVIA_SERVICE_DATA_DIR": "${ASTRAVIA_SERVICE_DATA_DIR}",
            "ASTRAVIA_SERVICE_RUNTIME_DIR": "${ASTRAVIA_SERVICE_RUNTIME_DIR}",
            "ASTRAVIA_SERVICE_CACHE_DIR": "${ASTRAVIA_SERVICE_CACHE_DIR}"
          }
        },
        "health": {
          "path": "/health",
          "timeoutMs": 20000
        }
      }
    ]
  },
  "agent": {
    "skillPaths": [
      "agent/skills/materialcraft"
    ],
    "skillPresentation": {
      "defaultVisibility": "visible",
      "surfaces": {
        "commandPalette": "visible",
        "skillPicker": "visible"
      }
    }
  },
  "description": "Build procedural materials node by node inside Astravia — the upstream MaterialCraft editor, from a first graph to a reusable material.",
  "author": "Astravia"
}
