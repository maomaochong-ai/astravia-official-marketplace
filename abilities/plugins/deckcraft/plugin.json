{
  "id": "deckcraft",
  "name": "%plugin.name%",
  "icon": "assets/icon.png",
  "version": "0.0.10",
  "defaultLocale": "en",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "deckcraft",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "ui.slot.activity-tab",
    "fs.read",
    "fs.write",
    "workspace.read",
    "agent.tools.register",
    "agent.toolHandler.execute",
    "agent.skills.control",
    "ui.shortcuts.register",
    "ui.slot.input-action",
    "ui.slot.tool-call"
  ],
  "agent": {
    "skillPaths": [
      "agent/skills/deckcraft"
    ],
    "skillPresentation": {
      "defaultVisibility": "visible",
      "surfaces": {
        "commandPalette": "visible",
        "skillPicker": "visible"
      }
    }
  },
  "description": "%plugin.description%",
  "author": "Astravia"
}
