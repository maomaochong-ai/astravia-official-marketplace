{
  "name": "@astravia-marketplace/hanshuang-pojia",
  "version": "2.17.24",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "verify:routing": "node --experimental-strip-types scripts/verify-routing.mjs",
    "test": "vitest run",
    "build": "vite build",
    "analyze": "node scripts/analyze.mjs",
    "sync:docs": "node scripts/sync-docs.mjs",
    "sync:system-prompt": "node scripts/sync-system-prompt.mjs",
    "sync:tool-index": "node scripts/sync-tool-index.mjs",
    "sync:precedents": "node scripts/sync-precedents.mjs",
    "sync:packs": "node scripts/sync-packs.mjs",
    "check:cases": "node scripts/check-precedent-package.mjs --all",
    "verify:generated": "node scripts/sync-docs.mjs --check && node scripts/sync-system-prompt.mjs --check && node scripts/sync-tool-index.mjs --check && node scripts/sync-precedents.mjs --check && node scripts/sync-packs.mjs --check && node scripts/sync-skill-library.mjs --check && node scripts/sync-icons.mjs --check && node scripts/sync-routing-table.mjs --check",
    "verify:docs": "node scripts/check-docs-deps.mjs --strict",
    "verify:probe": "node scripts/probe-refusal-selftest.mjs",
    "inject:matrix": "node scripts/inject-matrix.mjs",
    "verify:icon": "node scripts/sync-icons.mjs --check",
    "verify:routes": "node scripts/sync-routing-table.mjs --check",
    "verify:locale": "node scripts/report-unused-locale.mjs zh.json && node scripts/report-unused-locale.mjs en.json",
    "report:dead": "node scripts/report-dead-exports.mjs",
    "verify:cases": "node scripts/check-precedent-package.mjs --all"
  },
  "devDependencies": {
    "@astravia-org/plugin-sdk": "^0.3.10",
    "@astravia-org/plugin-vite": "^0.2.4",
    "@iconify-json/lucide": "^1.2.147",
    "@iconify-json/solar": "^1.2.13",
    "@tailwindcss/vite": "^4.1.12",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.1.1",
    "@types/react-dom": "^19.1.1",
    "jsdom": "^26.1.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tailwindcss": "^4.1.12",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  }
}
