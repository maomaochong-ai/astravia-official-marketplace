{
  "id": "dbx-pro",
  "name": "%plugin.name%",
  "icon": "assets/icon.png",
  "version": "0.0.33",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "dbx_pro",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "agent.mcp.control",
    "ui.slot.activity-tab",
    "ui.slot.input-action",
    "ui.slot.ability-detail",
    "agent.command.run",
    "agent.session.read",
    "agent.session.write",
    "storage.read",
    "storage.write",
    "shell.openExternal",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "github.com",
      "release-assets.githubusercontent.com",
      "objects.githubusercontent.com"
    ]
  },
  "providers": {
    "services": [
      {
        "id": "dbx-engine",
        "runtime": {
          "kind": "host-node",
          "version": "0.0.18",
          "entry": "server/main.mjs",
          "platforms": {
            "darwin-arm64": {
              "executable": "server/bin/dbx-mcp-darwin-arm64",
              "artifacts": [
                {
                  "sha256": "def0f2432f401c3e79c99261e3a29b05370d4aa5b6193e637d6a51ed7f620ab1",
                  "archive": "file",
                  "destination": "server/main.mjs"
                },
                {
                  "sha256": "7ef5d8cd0affe51caf33ab78263da9e78fb33dfb97264897dba2defd67c3845d",
                  "archive": "file",
                  "destination": "server/bin/dbx-mcp-darwin-arm64"
                }
              ]
            },
            "darwin-x64": {
              "executable": "server/bin/dbx-mcp-darwin-x64",
              "artifacts": [
                {
                  "sha256": "def0f2432f401c3e79c99261e3a29b05370d4aa5b6193e637d6a51ed7f620ab1",
                  "archive": "file",
                  "destination": "server/main.mjs"
                },
                {
                  "sha256": "b48f619a4b33c35c3cd90a495cd2b9fb45506ee420de590afa830f50866c3f36",
                  "archive": "file",
                  "destination": "server/bin/dbx-mcp-darwin-x64"
                }
              ]
            },
            "win32-x64": {
              "executable": "server/bin/dbx-mcp-win-x64.exe",
              "artifacts": [
                {
                  "sha256": "def0f2432f401c3e79c99261e3a29b05370d4aa5b6193e637d6a51ed7f620ab1",
                  "archive": "file",
                  "destination": "server/main.mjs"
                },
                {
                  "sha256": "25484f9b5af527dd0af7dde44d9f2a929ad92b2c4cfe654c9460ca7be51950a8",
                  "archive": "file",
                  "destination": "server/bin/dbx-mcp-win-x64.exe"
                }
              ]
            }
          }
        },
        "process": {
          "args": [
            "--port",
            "${ASTRAVIA_SERVICE_PORT}",
            "--data",
            "${ASTRAVIA_SERVICE_DATA_DIR}",
            "--auth-disabled"
          ]
        },
        "health": {
          "path": "/health",
          "timeoutMs": 30000
        }
      }
    ]
  },
  "commands": [
    "dbx"
  ],
  "agent": {
    "mcpServers": {
      "dbx-pro": {
        "type": "service",
        "serviceId": "dbx-engine",
        "path": "/mcp",
        "displayName": "dbx数据库",
        "description": "100+ 数据库连接与查询能力，支持列出连接、执行 SQL、查看表结构、获取 schema 上下文，用于 AI 数据分析、报表生成、表结构查询等数据库相关协作场景。"
      }
    }
  },
  "defaultLocale": "zh",
  "description": "%plugin.description%",
  "author": "Astravia"
}
