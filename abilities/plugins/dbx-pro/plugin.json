{
  "id": "dbx-pro",
  "name": "dbx-pro",
  "version": "0.0.90",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "dbx_pro",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "agent.mcp.control",
    "agent.skills.control",
    "agent.tools.register",
    "agent.toolHandler.execute",
    "ui.slot.activity-tab",
    "ui.slot.workspace-view",
    "ui.slot.input-action",
    "ui.slot.ability-detail",
    "agent.command.run",
    "agent.session.read",
    "agent.session.write",
    "storage.read",
    "storage.write",
    "fs.write",
    "shell.openExternal",
    "network.fetch"
  ],
  "network": {
    "allowedHosts": [
      "github.com",
      "release-assets.githubusercontent.com",
      "objects.githubusercontent.com"
    ]
  },
  "providers": {
    "services": [
      {
        "id": "dbx-engine",
        "runtime": {
          "kind": "host-node",
          "version": "0.0.20",
          "entry": "server/main.mjs",
          "platforms": {
            "darwin-arm64": {
              "executable": "server/bin/dbx-mcp-darwin-arm64",
              "artifacts": [
                {
                  "sha256": "53135b13d028733ab60013f1ae18ef34361c0a8b5a12a8dd4972c212f0826b03",
                  "archive": "file",
                  "destination": "server/main.mjs"
                },
                {
                  "sha256": "69e69e6aa273a7de57618275baed87928c9b2668d813b06dc86465317b482fb3",
                  "archive": "file",
                  "destination": "server/bin/dbx-mcp-darwin-arm64"
                }
              ]
            },
            "darwin-x64": {
              "executable": "server/bin/dbx-mcp-darwin-x64",
              "artifacts": [
                {
                  "sha256": "53135b13d028733ab60013f1ae18ef34361c0a8b5a12a8dd4972c212f0826b03",
                  "archive": "file",
                  "destination": "server/main.mjs"
                },
                {
                  "sha256": "e3198fd8a5348edf569aed2abedf2f30b9c0f512ae45976300b897f07a7536ce",
                  "archive": "file",
                  "destination": "server/bin/dbx-mcp-darwin-x64"
                }
              ]
            },
            "win32-x64": {
              "executable": "server/bin/dbx-mcp-win-x64.exe",
              "artifacts": [
                {
                  "sha256": "53135b13d028733ab60013f1ae18ef34361c0a8b5a12a8dd4972c212f0826b03",
                  "archive": "file",
                  "destination": "server/main.mjs"
                },
                {
                  "sha256": "598980a9a357203e2f68f8b6401b385f9928bf9443b13cd83f9986cfd66034cd",
                  "archive": "file",
                  "destination": "server/bin/dbx-mcp-win-x64.exe"
                }
              ]
            }
          }
        },
        "process": {
          "args": [
            "--port",
            "${ASTRAVIA_SERVICE_PORT}",
            "--data",
            "${ASTRAVIA_SERVICE_DATA_DIR}",
            "--auth-disabled"
          ]
        },
        "health": {
          "path": "/health",
          "timeoutMs": 30000
        }
      }
    ]
  },
  "commands": [
    "dbx"
  ],
  "agent": {
    "skillPaths": [
      "agent/skills/dbx-pro"
    ],
    "mcpServers": {
      "dbx-pro": {
        "type": "service",
        "serviceId": "dbx-engine",
        "path": "/mcp",
        "displayName": "dbx数据库",
        "description": "100+ 数据库连接与查询能力，支持列出连接、执行 SQL、查看表结构、获取 schema 上下文，用于 AI 数据分析、报表生成、表结构查询等数据库相关协作场景。"
      }
    }
  },
  "defaultLocale": "zh",
  "description": "%plugin.description%",
  "author": "Astravia"
}
