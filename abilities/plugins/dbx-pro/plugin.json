{
  "id": "dbx-pro",
  "name": "%plugin.name%",
  "icon": "assets/icon.png",
  "version": "0.0.16",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "dbx_pro",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "agent.mcp.control",
    "ui.slot.activity-tab",
    "ui.slot.ability-detail",
    "agent.command.run",
    "storage.read",
    "storage.write",
    "shell.openExternal"
  ],
  "providers": {
    "services": [
      {
        "id": "dbx-engine",
        "runtime": {
          "kind": "host-node",
          "version": "0.0.16",
          "entry": "service/main.mjs",
          "platforms": {
            "darwin-arm64": {
              "executable": "service/main.mjs",
              "artifacts": [
                {
                  "sha256": "394e86f51a38e5275ea0a25043539731abd95d7ab20791c2f0d5e8e1b8903fb6",
                  "archive": "file",
                  "destination": "service/main.mjs"
                },
                {
                  "sha256": "7ef5d8cd0affe51caf33ab78263da9e78fb33dfb97264897dba2defd67c3845d",
                  "archive": "file",
                  "destination": "service/bin/dbx-mcp-darwin-arm64"
                }
              ]
            },
            "darwin-x64": {
              "executable": "service/main.mjs",
              "artifacts": [
                {
                  "sha256": "394e86f51a38e5275ea0a25043539731abd95d7ab20791c2f0d5e8e1b8903fb6",
                  "archive": "file",
                  "destination": "service/main.mjs"
                },
                {
                  "sha256": "b48f619a4b33c35c3cd90a495cd2b9fb45506ee420de590afa830f50866c3f36",
                  "archive": "file",
                  "destination": "service/bin/dbx-mcp-darwin-x64"
                }
              ]
            },
            "win32-x64": {
              "executable": "service/main.mjs",
              "artifacts": [
                {
                  "sha256": "394e86f51a38e5275ea0a25043539731abd95d7ab20791c2f0d5e8e1b8903fb6",
                  "archive": "file",
                  "destination": "service/main.mjs"
                },
                {
                  "sha256": "25484f9b5af527dd0af7dde44d9f2a929ad92b2c4cfe654c9460ca7be51950a8",
                  "archive": "file",
                  "destination": "service/bin/dbx-mcp-win-x64.exe"
                }
              ]
            }
          }
        },
        "process": {
          "args": [
            "--port",
            "${ASTRAVIA_SERVICE_PORT}",
            "--data",
            "${ASTRAVIA_SERVICE_DATA_DIR}"
          ]
        },
        "health": {
          "path": "/health",
          "timeoutMs": 30000
        },
        "credentials": [
          {
            "id": "engine-key",
            "bytes": 32
          }
        ],
        "templates": [
          {
            "source": "service/main.mjs",
            "destination": "service/main.mjs",
            "mode": "create"
          },
          {
            "source": "service/bin/dbx-mcp-darwin-arm64",
            "destination": "service/bin/dbx-mcp-darwin-arm64",
            "mode": "create"
          },
          {
            "source": "service/bin/dbx-mcp-darwin-x64",
            "destination": "service/bin/dbx-mcp-darwin-x64",
            "mode": "create"
          },
          {
            "source": "service/bin/dbx-mcp-win-x64.exe",
            "destination": "service/bin/dbx-mcp-win-x64.exe",
            "mode": "create"
          }
        ]
      }
    ]
  },
  "commands": [
    "dbx"
  ],
  "agent": {
    "mcpServers": {
      "dbx-pro": {
        "type": "service",
        "serviceId": "dbx-engine",
        "path": "/mcp",
        "displayName": "dbx\u6570\u636e\u5e93",
        "description": "100+ \u6570\u636e\u5e93\u8fde\u63a5\u4e0e\u67e5\u8be2\u80fd\u529b\uff0c\u652f\u6301\u5217\u51fa\u8fde\u63a5\u3001\u6267\u884c SQL\u3001\u67e5\u770b\u8868\u7ed3\u6784\u3001\u83b7\u53d6 schema \u4e0a\u4e0b\u6587\uff0c\u7528\u4e8e AI \u6570\u636e\u5206\u6790\u3001\u62a5\u8868\u751f\u6210\u3001\u8868\u7ed3\u6784\u67e5\u8be2\u7b49\u6570\u636e\u5e93\u76f8\u5173\u534f\u4f5c\u573a\u666f\u3002"
      }
    }
  },
  "defaultLocale": "zh",
  "description": "%plugin.description%",
  "author": "Astravia"
}
