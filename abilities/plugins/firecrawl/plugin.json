{
  "id": "firecrawl",
  "name": "%name%",
  "version": "0.3.1",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "firecrawl",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "minAppVersion": "0.5.60",
  "permissions": [
    "network.fetch",
    "agent.tools.register",
    "agent.toolHandler.execute",
    "agent.skills.control",
    "ui.slot.activity-tab",
    "ui.slot.input-action",
    "browser.read",
    "browser.interact",
    "ai.complete",
    "agent.session.read",
    "browser.profile.persist",
    "storage.read",
    "storage.write",
    "fs.write",
    "secrets.read",
    "secrets.write",
    "fs.read"
  ],
  "browser": {
    "allowedHosts": [
      "*"
    ]
  },
  "network": {
    "allowedHosts": [
      "*"
    ]
  },
  "agent": {
    "skillPaths": [
      "agent/skills/firecrawl"
    ],
    "skillPresentation": {
      "defaultVisibility": "visible",
      "surfaces": {
        "skillPicker": "visible",
        "commandPalette": "visible",
        "abilityCatalog": "visible",
        "agentConfiguration": "visible",
        "pluginDetail": "visible"
      },
      "skills": {
        "firecrawl": {
          "displayName": "Firecrawl",
          "displayDescription": "Read the web as Markdown, and see what a page is made of: scrape one page, map a site, crawl a section, search, extract structured fields, parse PDF/DOCX/XLSX, download a video stream, and follow hosted jobs or scheduled monitors."
        }
      }
    }
  },
  "description": "%description%",
  "author": "Astravia Community",
  "defaultLocale": "en"
}
