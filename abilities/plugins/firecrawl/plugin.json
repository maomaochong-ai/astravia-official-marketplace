{
  "id": "firecrawl",
  "name": "%name%",
  "version": "0.4.1",
  "pluginApiVersion": "^2.0.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "firecrawl",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "minAppVersion": "0.5.60",
  "permissions": [
    "network.fetch",
    "agent.tools.register",
    "agent.toolHandler.execute",
    "agent.skills.control",
    "ui.slot.activity-tab",
    "ui.slot.input-action",
    "ui.slot.ability-detail",
    "ui.slot.tool-call",
    "agent.session.read",
    "agent.session.write",
    "storage.read",
    "storage.write",
    "secrets.read",
    "secrets.write",
    "fs.read",
    "shell.openExternal"
  ],
  "network": {
    "allowedHosts": [
      "*"
    ]
  },
  "agent": {
    "skillPaths": [
      "agent/skills/firecrawl"
    ],
    "skillPresentation": {
      "defaultVisibility": "visible",
      "surfaces": {
        "skillPicker": "visible",
        "commandPalette": "visible",
        "abilityCatalog": "visible",
        "agentConfiguration": "visible",
        "pluginDetail": "visible"
      },
      "skills": {
        "firecrawl": {
          "displayName": "Firecrawl Connector",
          "displayDescription": "Read pages through the Firecrawl API as Markdown, with optional HTML, links, screenshots, images, video and audio URLs, summaries or schema-shaped JSON. Crawl a section, map a site, search, parse PDF/DOCX/XLSX, drive a stateful browser session, ask the browsing agent for a cross-page answer, and follow hosted jobs or scheduled monitors."
        }
      }
    }
  },
  "description": "%description%",
  "author": "Astravia Community",
  "defaultLocale": "en"
}
