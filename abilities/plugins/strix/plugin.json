{
  "id": "strix",
  "name": "%plugin.name%",
  "icon": "assets/icon.png",
  "version": "0.6.3",
  "defaultLocale": "en",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "strix",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "ui.slot.activity-tab",
    "ui.slot.input-action",
    "ui.shortcuts.register",
    "agent.session.read",
    "agent.session.write",
    "agent.skills.control",
    "agent.mcp.control"
  ],
  "providers": {
    "services": [
      {
        "id": "strix-bridge",
        "runtime": {
          "kind": "host-node",
          "version": "0.5.0",
          "entry": "dist/service/main.mjs",
          "platforms": {
            "win32-x64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "351506ec4eac5a7c5093623db3d4e31f1289610dc44b2d4875708cc4e4cade39",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            },
            "darwin-x64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "351506ec4eac5a7c5093623db3d4e31f1289610dc44b2d4875708cc4e4cade39",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "351506ec4eac5a7c5093623db3d4e31f1289610dc44b2d4875708cc4e4cade39",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            },
            "linux-x64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "351506ec4eac5a7c5093623db3d4e31f1289610dc44b2d4875708cc4e4cade39",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            },
            "linux-arm64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "351506ec4eac5a7c5093623db3d4e31f1289610dc44b2d4875708cc4e4cade39",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            }
          }
        },
        "process": {
          "args": [],
          "env": {
            "ASTRAVIA_SERVICE_PORT": "${ASTRAVIA_SERVICE_PORT}",
            "ASTRAVIA_SERVICE_DATA_DIR": "${ASTRAVIA_SERVICE_DATA_DIR}",
            "ASTRAVIA_SERVICE_RUNTIME_DIR": "${ASTRAVIA_SERVICE_RUNTIME_DIR}",
            "ASTRAVIA_SERVICE_CACHE_DIR": "${ASTRAVIA_SERVICE_CACHE_DIR}"
          }
        },
        "health": {
          "path": "/api/health/ready",
          "timeoutMs": 120000
        }
      }
    ]
  },
  "agent": {
    "skillPaths": [
      "agent/skills"
    ],
    "skillPresentation": {
      "defaultVisibility": "hidden",
      "surfaces": {
        "abilityCatalog": "hidden",
        "agentConfiguration": "hidden",
        "commandPalette": "hidden",
        "skillPicker": "hidden",
        "pluginDetail": "hidden"
      },
      "skills": {
        "api-security-testing": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "application-security-testing": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "ci-security-scanning-with-strix": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "find-security-vulnerabilities-in-code": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "fix-security-vulnerabilities-with-strix": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "managed-pentesting-with-strix": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "owasp-top-10-testing": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "penetration-testing-with-strix": {
          "defaultVisibility": "visible",
          "surfaces": {
            "abilityCatalog": "visible",
            "agentConfiguration": "visible",
            "commandPalette": "visible",
            "skillPicker": "visible",
            "pluginDetail": "visible"
          },
          "displayName": "Strix",
          "displayDescription": "%skill.entry.description%"
        },
        "web-app-penetration-testing": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        }
      }
    },
    "mcpServers": {
      "strix": {
        "type": "service",
        "serviceId": "strix-bridge",
        "path": "/mcp",
        "displayName": "Strix security toolkit",
        "description": "Strix sandbox, its skill library, and a findings ledger, for the agent to drive."
      }
    }
  },
  "description": "%plugin.description%",
  "author": "usestrix"
}
