{
  "id": "strix",
  "name": "%plugin.name%",
  "icon": "assets/icon.png",
  "version": "0.3.2",
  "defaultLocale": "en",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "strix",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "ui.slot.activity-tab",
    "ui.slot.input-action",
    "agent.skills.control",
    "agent.mcp.control",
    "agent.command.run",
    "agent.command.spawn",
    "storage.read",
    "storage.write",
    "shell.openExternal"
  ],
  "commands": [
    "python",
    "python3",
    "uv",
    "pipx",
    "docker"
  ],
  "providers": {
    "cli": [
      {
        "id": "strix",
        "command": "strix",
        "probe": {
          "args": [
            "--version"
          ],
          "timeoutMs": 60000
        },
        "install": {
          "command": "uv",
          "args": [
            "tool",
            "install",
            "strix-agent"
          ],
          "timeoutMs": 600000
        }
      }
    ],
    "services": [
      {
        "id": "strix-bridge",
        "runtime": {
          "kind": "host-node",
          "version": "0.3.2",
          "entry": "dist/service/main.mjs",
          "platforms": {
            "win32-x64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "88970e6ac78041e274afb02726f9c77d24bed6d4ce7b316f9d90a82f015cc2b6",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            },
            "darwin-x64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "88970e6ac78041e274afb02726f9c77d24bed6d4ce7b316f9d90a82f015cc2b6",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "88970e6ac78041e274afb02726f9c77d24bed6d4ce7b316f9d90a82f015cc2b6",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            },
            "linux-x64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "88970e6ac78041e274afb02726f9c77d24bed6d4ce7b316f9d90a82f015cc2b6",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            },
            "linux-arm64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "88970e6ac78041e274afb02726f9c77d24bed6d4ce7b316f9d90a82f015cc2b6",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            }
          }
        },
        "process": {
          "args": [],
          "env": {
            "ASTRAVIA_SERVICE_PORT": "${ASTRAVIA_SERVICE_PORT}",
            "ASTRAVIA_SERVICE_DATA_DIR": "${ASTRAVIA_SERVICE_DATA_DIR}",
            "ASTRAVIA_SERVICE_RUNTIME_DIR": "${ASTRAVIA_SERVICE_RUNTIME_DIR}",
            "ASTRAVIA_SERVICE_CACHE_DIR": "${ASTRAVIA_SERVICE_CACHE_DIR}"
          }
        },
        "health": {
          "path": "/api/health/ready",
          "timeoutMs": 120000
        }
      }
    ]
  },
  "agent": {
    "skillPaths": [
      "agent/skills"
    ],
    "skillPresentation": {
      "defaultVisibility": "hidden",
      "surfaces": {
        "abilityCatalog": "hidden",
        "agentConfiguration": "hidden",
        "commandPalette": "hidden",
        "skillPicker": "hidden",
        "pluginDetail": "hidden"
      },
      "skills": {
