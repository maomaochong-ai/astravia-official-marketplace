{
  "id": "strix",
  "name": "%plugin.name%",
  "icon": "assets/icon.png",
  "version": "1.7.3",
  "defaultLocale": "en",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "strix",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "ui.slot.activity-tab",
    "ui.slot.input-action",
    "ui.shortcuts.register",
    "agent.session.read",
    "agent.session.write",
    "agent.skills.control",
    "agent.mcp.control",
    "workspace.read"
  ],
  "providers": {
    "services": [
      {
        "id": "strix-bridge",
        "runtime": {
          "kind": "host-node",
          "version": "0.5.0",
          "entry": "dist/service/main.mjs",
          "platforms": {
            "win32-x64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "1bb17234c45181e756ea9c7a72722b4d908dc86869faed1cd698f1cc11b989e6",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            },
            "darwin-x64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "1bb17234c45181e756ea9c7a72722b4d908dc86869faed1cd698f1cc11b989e6",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "1bb17234c45181e756ea9c7a72722b4d908dc86869faed1cd698f1cc11b989e6",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            },
            "linux-x64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "1bb17234c45181e756ea9c7a72722b4d908dc86869faed1cd698f1cc11b989e6",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            },
            "linux-arm64": {
              "executable": "dist/service/main.mjs",
              "artifacts": [
                {
                  "sha256": "1bb17234c45181e756ea9c7a72722b4d908dc86869faed1cd698f1cc11b989e6",
                  "archive": "file",
                  "destination": "dist/service/main.mjs"
                }
              ]
            }
          }
        },
        "process": {
          "args": [],
          "env": {
            "ASTRAVIA_SERVICE_PORT": "${ASTRAVIA_SERVICE_PORT}",
            "ASTRAVIA_SERVICE_DATA_DIR": "${ASTRAVIA_SERVICE_DATA_DIR}",
            "ASTRAVIA_SERVICE_RUNTIME_DIR": "${ASTRAVIA_SERVICE_RUNTIME_DIR}",
            "ASTRAVIA_SERVICE_CACHE_DIR": "${ASTRAVIA_SERVICE_CACHE_DIR}"
          }
        },
        "health": {
          "path": "/api/health/ready",
          "timeoutMs": 120000
        }
      }
    ]
  },
  "agent": {
    "skillPaths": [
      "agent/skills"
    ],
    "skillPresentation": {
      "defaultVisibility": "hidden",
      "surfaces": {
        "abilityCatalog": "hidden",
        "agentConfiguration": "hidden",
        "commandPalette": "hidden",
        "skillPicker": "hidden",
        "pluginDetail": "hidden"
      },
      "skills": {
        "api-security-testing": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "application-security-testing": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "ci-security-scanning-with-strix": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "find-security-vulnerabilities-in-code": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "fix-security-vulnerabilities-with-strix": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "managed-pentesting-with-strix": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "owasp-top-10-testing": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        },
        "penetration-testing-with-strix": {
          "defaultVisibility": "visible",
          "surfaces": {
            "abilityCatalog": "visible",
            "agentConfiguration": "visible",
            "commandPalette": "visible",
            "skillPicker": "visible",
            "pluginDetail": "visible"
          },
          "displayName": "Strix",
          "displayDescription": "%skill.entry.description%"
        },
        "web-app-penetration-testing": {
          "defaultVisibility": "hidden",
          "surfaces": {
            "abilityCatalog": "hidden",
            "agentConfiguration": "hidden",
            "commandPalette": "hidden",
            "skillPicker": "hidden",
            "pluginDetail": "hidden"
          }
        }
      }
    },
    "mcpServers": {
      "strix": {
        "type": "service",
        "serviceId": "strix-bridge",
        "path": "/mcp",
        "displayName": "Strix security toolkit",
        "description": "Strix sandbox, its skill library, and a findings ledger, for the agent to drive."
      }
    },
    "agents": [
      {
        "id": "strix-lead",
        "name": "%agent.lead.name%",
        "description": "%agent.lead.description%",
        "mentionHandle": "strix",
        "abilities": "all",
        "roles": [
          "master"
        ],
        "systemPromptPath": "agent/agents/lead.md"
      },
      {
        "id": "strix-recon",
        "name": "%agent.recon.name%",
        "description": "%agent.recon.description%",
        "mentionHandle": "recon",
        "abilities": "all",
        "roles": [
          "researcher"
        ],
        "systemPromptPath": "agent/agents/recon.md"
      },
      {
        "id": "strix-exploit",
        "name": "%agent.exploit.name%",
        "description": "%agent.exploit.description%",
        "mentionHandle": "exploit",
        "abilities": "all",
        "roles": [
          "developer"
        ],
        "systemPromptPath": "agent/agents/exploit.md"
      },
      {
        "id": "strix-auditor",
        "name": "%agent.auditor.name%",
        "description": "%agent.auditor.description%",
        "mentionHandle": "auditor",
        "abilities": "all",
        "roles": [
          "auditor"
        ],
        "systemPromptPath": "agent/agents/auditor.md"
      }
    ],
    "teams": [
      {
        "id": "strix-assessment",
        "name": "%team.assessment.name%",
        "description": "%team.assessment.description%",
        "workflowPath": "agent/prompts/team-workflow.md",
        "members": [
          {
            "agent": "strix-lead",
            "responsibility": "定范围与额度、分派、验收，最后出报告；用户只跟这位说话"
          },
          {
            "agent": "strix-recon",
            "responsibility": "先摸清暴露面：主机、端口、服务、Web 路径与认证入口，看到的一律记进覆盖台账",
            "instructionsPath": "agent/prompts/briefs/recon.md"
          },
          {
            "agent": "strix-exploit",
            "responsibility": "把线索打成可复现的证据，登记发现并署名；打不开也记下为什么",
            "instructionsPath": "agent/prompts/briefs/exploit.md"
          },
          {
            "agent": "strix-auditor",
            "responsibility": "核证据、核严重级、核覆盖有没有说谎；核不住的发现删掉",
            "instructionsPath": "agent/prompts/briefs/auditor.md"
          }
        ]
      }
    ]
  },
  "description": "%plugin.description%",
  "author": "usestrix"
}
