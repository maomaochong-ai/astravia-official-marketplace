    },
    "mcpServers": {
      "strix": {
        "type": "service",
        "serviceId": "strix-bridge",
        "path": "/mcp",
        "displayName": "Strix security toolkit",
        "description": "Strix sandbox, its 78 security skills, and a findings ledger, for the agent to drive."
      }
    }
  },
  "description": "%plugin.description%",
  "author": "usestrix"
}
