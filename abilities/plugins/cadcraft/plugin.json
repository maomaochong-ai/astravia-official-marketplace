{
  "id": "cadcraft",
  "name": "CADCraft",
  "icon": "assets/icon.png",
  "version": "0.0.1",
  "defaultLocale": "en",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "cadcraft",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "ui.slot.activity-tab",
    "browser.open",
    "shell.openExternal",
    "fs.read",
    "fs.write",
    "workspace.read",
    "agent.tools.register",
    "agent.toolHandler.execute",
    "agent.skills.control"
  ],
  "browser": {
    "allowedHosts": [
      "127.0.0.1"
    ]
  },
  "providers": {
    "services": [
      {
        "id": "cadcraft-hub",
        "runtime": {
          "kind": "host-node",
          "version": "0.0.1",
          "entry": "server/hub.mjs",
          "platforms": {
            "win32-x64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "f31f5bcf24ab8d089e4d8389e9d3fae4798c45c19487662e92f9e72068a65dc8",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            },
            "darwin-x64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "f31f5bcf24ab8d089e4d8389e9d3fae4798c45c19487662e92f9e72068a65dc8",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            },
            "darwin-arm64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "f31f5bcf24ab8d089e4d8389e9d3fae4798c45c19487662e92f9e72068a65dc8",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            },
            "linux-x64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "f31f5bcf24ab8d089e4d8389e9d3fae4798c45c19487662e92f9e72068a65dc8",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            },
            "linux-arm64": {
              "executable": "server/hub.mjs",
              "artifacts": [
                {
                  "sha256": "f31f5bcf24ab8d089e4d8389e9d3fae4798c45c19487662e92f9e72068a65dc8",
                  "archive": "file",
                  "destination": "server/hub.mjs"
                }
              ]
            }
          }
        },
        "process": {
          "args": [],
          "env": {
            "ASTRAVIA_SERVICE_PORT": "${ASTRAVIA_SERVICE_PORT}",
            "ASTRAVIA_SERVICE_DATA_DIR": "${ASTRAVIA_SERVICE_DATA_DIR}",
            "ASTRAVIA_SERVICE_RUNTIME_DIR": "${ASTRAVIA_SERVICE_RUNTIME_DIR}",
            "ASTRAVIA_SERVICE_CACHE_DIR": "${ASTRAVIA_SERVICE_CACHE_DIR}"
          }
        },
        "health": {
          "path": "/health",
          "timeoutMs": 20000
        }
      }
    ]
  },
  "agent": {
    "skillPaths": [
      "agent/skills/cadcraft"
    ],
    "skillPresentation": {
      "defaultVisibility": "visible",
      "surfaces": {
        "commandPalette": "visible",
        "skillPicker": "visible"
      }
    }
  },
  "description": "Draft and edit drawings inside Astravia — the upstream CADCraft editor, with a real command line, object snaps, layers, dimensions, hatches, blocks, and DXF and DWG files.",
  "author": "Astravia"
}
