{
  "id": "logocreator",
  "name": "%name%",
  "version": "0.3.0",
  "icon": "assets/icon.png",
  "defaultLocale": "zh",
  "pluginApiVersion": "^2.4.0",
  "entry": "dist/mf-manifest.json",
  "moduleFederation": {
    "remoteName": "logocreator",
    "expose": "./plugin"
  },
  "styles": [
    "dist/style.css"
  ],
  "permissions": [
    "ui.slot.activity-tab",
    "ui.slot.input-action",
    "agent.tools.register",
    "agent.toolHandler.execute",
    "agent.skills.control",
    "agent.session.write",
    "storage.read",
    "storage.write",
    "fs.read",
    "fs.write",
    "media.generate"
  ],
  "agent": {
    "skillPaths": [
      "agent/skills/logocreator"
    ],
    "skillPresentation": {
      "defaultVisibility": "hidden",
      "skills": {
        "logocreator": {
          "defaultVisibility": "visible",
          "displayName": "%name%"
        }
      }
    },
    "agents": [
      {
        "id": "logo-master",
        "name": "%agent.logoMaster.name%",
        "description": "%agent.logoMaster.description%",
        "mentionHandle": "logo-master",
        "avatar": "agent/agents/logo-master.webp",
        "systemPromptPath": "agent/agents/logo-master.md",
        "roles": [
          "designer"
        ],
        "abilities": "own"
      }
    ]
  },
  "description": "%description%",
  "author": "Astravia"
}
